{
  "version": 2,
  "global": {
    "adminPassword": "CHANGE-ME",
    "exitPassword": "CHANGE-ME",
    "hideExit": true
  },
  "profiles": [
    {
      "id": "terminal",
      "name": "Warehouse terminal",
      "startUrl": "https://wms.example.com/terminal",
      "allowList": ["wms.example.com", "sso.example.com"],
      "launchOnStartup": true,
      "clearCacheOnStart": true,
      "clearCookiesOnStart": true,
      "allowDownloads": false,
      "viewport": { "mode": "device", "fitToScreen": false, "pinchZoom": false },
      "keyboard": {
        "soft": "system",
        "showOnFocus": false,
        "backKey": "{BACK}",
        "hotkeys": { "toggleKeyboard": "F12", "menu": "F11" }
      },
      "errorPages": { "showHttpErrors": true },
      "kiosk": {
        "hideToolbar": true,
        "immersive": true,
        "keepScreenOn": true,
        "orientation": "portrait"
      },
      "scanner": { "enabled": true, "terminator": "enter" },
      "sounds": { "scanOk": "none", "error": "error" }
    }
  ]
}
