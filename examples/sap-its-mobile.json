{
  "version": 2,
  "global": {
    "adminPassword": "CHANGE-ME",
    "hideExit": false
  },
  "profiles": [
    {
      "id": "sap-mobile",
      "name": "SAP mobile",
      "startUrl": "https://sap.example.com/sap/bc/gui/sap/its/zmobile?sap-language=en",
      "allowList": ["sap.example.com"],
      "launchOnStartup": true,
      "clearCookiesOnStart": true,
      "allowDownloads": false,
      "viewport": {
        "mode": "device",
        "fitToScreen": false,
        "textZoom": 100,
        "pinchZoom": true
      },
      "keyboard": {
        "soft": "system",
        "showOnFocus": false,
        "hotkeys": { "toggleKeyboard": "F12" }
      },
      "kiosk": {
        "keepScreenOn": true,
        "orientation": "portrait"
      },
      "scanner": {
        "enabled": true,
        "terminator": "enter"
      }
    }
  ]
}
